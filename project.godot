; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=100

[admob]

general/android/app_id="ca-app-pub-3443422868739312~2600782108"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="projectGame"
config/tags=PackedStringArray("projects")
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.12549, 0.12549, 0.12549, 1)
boot_splash/image="res://ic_launcher/res/mipmap-xxxhdpi/ic_launcher_adaptive_fore.png"
config/icon="res://icon.png"

[autoload]

Settings="*res://settings.gd"
GodotPlayGameServices="*res://addons/GodotPlayGameServices/scripts/autoloads/godot_play_game_services.gd"
PlayGames="*res://play_games.gd"

[debug]

settings/stdout/print_fps=true

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.301961, 0.301961, 0.301961, 1)
